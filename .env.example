PORT=3001

# O docker-compose publica o MySQL do container na porta 3307 do host
# (mapeamento 3307:3306). Use 3306 apenas se o MySQL for local, fora do Docker.
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=foodexpress

# Obrigatório: a API não sobe sem JWT_SECRET.
# Gere uma chave com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
