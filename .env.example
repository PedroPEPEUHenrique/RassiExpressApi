PORT=3001

# O docker-compose publica o MySQL do container na porta 3307 do host
# (mapeamento 3307:3306). Use 3306 apenas se o MySQL for local, fora do Docker.
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=foodexpress

# Obrigatório: a API não sobe sem JWT_SECRET.
# Gere uma chave com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# CORS
#
# Origens de NAVEGADOR permitidas, separadas por vírgula. O app nativo não
# envia cabeçalho Origin e passa independentemente desta lista — deixe vazio
# enquanto o único cliente for o aplicativo.
# Ex.: CORS_ORIGINS=http://localhost:8081,https://painel.seurestaurante.com
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Rate limit
#
# Quantos proxies existem na frente da API (nginx, PaaS). Com 0, o IP do
# cliente é lido direto da conexão. Confiar em X-Forwarded-For sem proxy real
# deixaria qualquer um forjar o próprio IP e escapar do limite.
TRUST_PROXY=0

# Escudo por IP, por minuto. Generoso de propósito: todos os aparelhos de um
# restaurante saem pelo mesmo IP, e o tablet da cozinha faz polling a cada 10s.
RATE_LIMIT_GLOBAL=300

# Operações de escrita por USUÁRIO autenticado, por minuto.
RATE_LIMIT_ESCRITA=60

# Login, em janela de 15 minutos. O limite por IP é frouxo (a equipe divide o
# IP da casa); o por e-mail é o que barra força bruta.
RATE_LIMIT_LOGIN_IP=40
RATE_LIMIT_LOGIN_EMAIL=8
